# ==========================================
# GEMINI AI API CONFIGURATION
# ==========================================
GEMINI_API_KEY="tu_clave_de_gemini_aqui"
APP_URL="http://localhost:3000"
PORT=3000

# ==============================================================================
# OPCIÓN A (RECOMENDADA): GOOGLE APPS SCRIPT WEB APP (100% GRATIS SIN GOOGLE CLOUD)
# ==============================================================================
# Instrucciones:
# 1. Abre tu hoja en Google Sheets > Extensiones > Apps Script.
# 2. Pega el código de `google-apps-script.js`.
# 3. Implementar > Nueva implementación > Aplicación web > Acceso: Cualquier usuario.
# 4. Pega aquí la URL generada:
GOOGLE_APPS_SCRIPT_URL="https://script.google.com/macros/s/TU_SCRIPT_ID/exec"

# Token opcional si definiste uno en google-apps-script.js
GOOGLE_APPS_SCRIPT_SECRET_TOKEN=""

# ID opcional de carpeta de Google Drive para fotos (si se deja vacío, se auto-crea "NutriVoice_Fotos")
GOOGLE_DRIVE_FOLDER_ID=""

# ==============================================================================
# OPCIÓN B (AVANZADA): GOOGLE CLOUD PLATFORM (Service Account)
# ==============================================================================
# Si prefieres usar Google Cloud Console en vez de Apps Script, descomenta:
# GOOGLE_SPREADSHEET_ID="tu_google_spreadsheet_id"
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE="./service-account.json"
